/**
 * profileAI — turns raw resume text into structured Master Career Profile
 * data (section 2/4 of spec).
 *
 * Provider selection: uses Gemini if GEMINI_API_KEY is set (recommended —
 * free tier available, no billing account required). Falls back to
 * Anthropic if only ANTHROPIC_API_KEY is set. The Anthropic code path is
 * left fully intact and untouched below; nothing about it changed.
 *
 * IMPORTANT — status: CODE VERIFIED, not runtime tested in this sandbox.
 * Both providers require network access this offline environment doesn't
 * have. The JSON schema, prompt rules, and post-processing guards are
 * shared identically between both providers and are unchanged from the
 * original Anthropic-only implementation.
 *
 * Defense in depth: the prompt instructs the model never to invent data,
 * but this code does NOT trust the model's word for it. Every extracted
 * skill still goes through buildSkillEvidence() (lib/skills.ts), which
 * independently re-derives years/confidence from the extracted work
 * experience dates. If the model hallucinates a skill's years directly, the
 * hallucinated number is discarded here, not persisted. This guard applies
 * identically regardless of which provider produced the raw extraction.
 */

import { RawSkillMention, ExplicitSkillStatement, buildSkillEvidence } from "./skills";
import { EducationRecord, SkillEvidence, WorkExperience } from "./types";

const EXTRACTION_SYSTEM_PROMPT = `You extract structured career data from resume text. You must not invent, infer, or guess any information that is not explicitly present in the text.

Rules you must follow exactly:
- If a job title or employer is unclear or missing, use the literal string "Unknown — review required" and set needsReview to true for that entry.
- Never turn a skill, achievement, or technology into a fake job entry.
- Never estimate or invent employment dates. If a date is missing or ambiguous, set it to null.
- For skills, only include an "explicitYears" field if the resume contains an explicit statement like "5 years of X". Otherwise omit it entirely. Do NOT estimate years for a skill based on how it sounds or how many jobs mention it.
- Extract achievements and responsibilities as separate arrays; do not blend them.
- Extract leadership evidence only as literal or closely paraphrased text spans that indicate leading people/projects (e.g. "managed a team of 6") — do not infer leadership from a title alone (e.g. do not assume "Senior Engineer" implies leadership).
- Output strict JSON matching the provided schema. No prose, no markdown fences.`;

const EXTRACTION_SCHEMA_HINT = `{
  "workExperience": [{
    "jobTitle": string,
    "employer": string,
    "startDate": string | null,   // "YYYY-MM" if known, else null
    "endDate": string | null,
    "isCurrent": boolean,
    "responsibilities": string[],
    "achievements": string[],
    "technologies": string[],
    "employmentType": "full-time" | "part-time" | "contract" | "internship" | "freelance" | "unknown",
    "leadershipEvidence": string[],
    "needsReview": boolean
  }],
  "education": [{
    "institution": string,
    "credential": string,
    "field": string | null,
    "graduationDate": string | null
  }],
  "skillsListed": string[],          // raw skills as they appear anywhere in the resume
  "explicitSkillStatements": [{ "skillName": string, "years": number, "sourceText": string }]
}`;

// Same shape as EXTRACTION_SCHEMA_HINT above, expressed as a Gemini
// structured-output schema so the API enforces it directly rather than
// relying on prompt instruction alone. This does not change the schema or
// any business rule — it's the identical shape in the format Gemini's
// responseSchema requires.
const GEMINI_RESPONSE_SCHEMA = {
  type: "OBJECT",
  properties: {
    workExperience: {
      type: "ARRAY",
      items: {
        type: "OBJECT",
        properties: {
          jobTitle: { type: "STRING" },
          employer: { type: "STRING" },
          startDate: { type: "STRING", nullable: true },
          endDate: { type: "STRING", nullable: true },
          isCurrent: { type: "BOOLEAN" },
          responsibilities: { type: "ARRAY", items: { type: "STRING" } },
          achievements: { type: "ARRAY", items: { type: "STRING" } },
          technologies: { type: "ARRAY", items: { type: "STRING" } },
          employmentType: {
            type: "STRING",
            enum: ["full-time", "part-time", "contract", "internship", "freelance", "unknown"],
          },
          leadershipEvidence: { type: "ARRAY", items: { type: "STRING" } },
          needsReview: { type: "BOOLEAN" },
        },
        required: ["jobTitle", "employer", "isCurrent", "employmentType", "needsReview"],
      },
    },
    education: {
      type: "ARRAY",
      items: {
        type: "OBJECT",
        properties: {
          institution: { type: "STRING" },
          credential: { type: "STRING" },
          field: { type: "STRING", nullable: true },
          graduationDate: { type: "STRING", nullable: true },
        },
        required: ["institution", "credential"],
      },
    },
    skillsListed: { type: "ARRAY", items: { type: "STRING" } },
    explicitSkillStatements: {
      type: "ARRAY",
      items: {
        type: "OBJECT",
        properties: {
          skillName: { type: "STRING" },
          years: { type: "NUMBER" },
          sourceText: { type: "STRING" },
        },
        required: ["skillName", "years", "sourceText"],
      },
    },
  },
  required: ["workExperience", "education", "skillsListed", "explicitSkillStatements"],
};

// Overridable via env var since Google renames/retires free-tier Flash
// models periodically; defaults to a current free-tier-eligible model.
const GEMINI_MODEL = process.env.GEMINI_MODEL || "gemini-2.0-flash";

interface RawExtractionResult {
  workExperience: Array<{
    jobTitle: string;
    employer: string;
    startDate: string | null;
    endDate: string | null;
    isCurrent: boolean;
    responsibilities: string[];
    achievements: string[];
    technologies: string[];
    employmentType: WorkExperience["employmentType"];
    leadershipEvidence: string[];
    needsReview: boolean;
  }>;
  education: Array<{
    institution: string;
    credential: string;
    field: string | null;
    graduationDate: string | null;
  }>;
  skillsListed: string[];
  explicitSkillStatements: ExplicitSkillStatement[];
}

async function extractWithGemini(resumeText: string, apiKey: string): Promise<RawExtractionResult> {
  const response = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`,
    {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-goog-api-key": apiKey,
      },
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: EXTRACTION_SYSTEM_PROMPT }] },
        contents: [{ role: "user", parts: [{ text: resumeText }] }],
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: GEMINI_RESPONSE_SCHEMA,
          maxOutputTokens: 4096,
        },
      }),
    }
  );

  if (!response.ok) {
    throw new Error(`Resume extraction request failed with status ${response.status}`);
  }

  const data = await response.json();
  const text =
    data.candidates?.[0]?.content?.parts?.map((part: any) => part.text ?? "").join("") ?? "";

  try {
    return JSON.parse(text.trim());
  } catch {
    throw new Error("Resume extraction returned an unparseable response. Please try re-uploading.");
  }
}

async function extractWithAnthropic(resumeText: string, apiKey: string): Promise<RawExtractionResult> {
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "x-api-key": apiKey,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: "gemini-1.5-flash",
      max_tokens: 4096,
      system: `${EXTRACTION_SYSTEM_PROMPT}\n\nSchema:\n${EXTRACTION_SCHEMA_HINT}`,
      messages: [{ role: "user", content: resumeText }],
    }),
  });

  if (!response.ok) {
    throw new Error(`Resume extraction request failed with status ${response.status}`);
  }

  const data = await response.json();
  const text = data.content?.map((block: any) => block.text ?? "").join("") ?? "";

  try {
    const cleaned = text.replace(/```json|```/g, "").trim();
    return JSON.parse(cleaned);
  } catch {
    throw new Error("Resume extraction returned an unparseable response. Please try re-uploading.");
  }
}

/**
 * Post-processing shared identically by every provider — unchanged from
 * the original implementation. This is where the anti-hallucination guard
 * lives (skill years re-derived from dated work experience, never trusted
 * from the model), so it applies the same way no matter which provider
 * produced the raw JSON above it.
 */
function postProcessExtraction(parsed: RawExtractionResult): {
  workExperience: WorkExperience[];
  education: EducationRecord[];
  skills: SkillEvidence[];
} {
  const workExperience: WorkExperience[] = parsed.workExperience.map((w, i) => ({
    id: `pending_${i}`, // replaced with a real DB id on insert
    jobTitle: w.jobTitle || "Unknown — review required",
    employer: w.employer || "Unknown — review required",
    period: { startDate: w.startDate, endDate: w.endDate, isCurrent: w.isCurrent },
    responsibilities: w.responsibilities ?? [],
    achievements: w.achievements ?? [],
    technologies: w.technologies ?? [],
    employmentType: w.employmentType ?? "unknown",
    leadershipEvidence: w.leadershipEvidence ?? [],
    source: "resume upload",
    needsReview:
      w.needsReview ||
      w.jobTitle === "Unknown — review required" ||
      w.employer === "Unknown — review required",
  }));

  const education: EducationRecord[] = parsed.education.map((e, i) => ({
    id: `pending_${i}`,
    institution: e.institution,
    credential: e.credential,
    field: e.field,
    graduationDate: e.graduationDate,
    source: "resume upload",
  }));

  // This is the critical guard: skill years are NOT taken from the model's
  // output directly. They are re-derived here from the (already extracted)
  // dated work experience, exactly as lib/skills.ts enforces everywhere else
  // in the app. This makes it impossible for a model hallucination about
  // skill years to reach the database.
  const rawSkills: RawSkillMention[] = (parsed.skillsListed ?? []).map((s) => ({ skillName: s }));
  const skills = buildSkillEvidence(rawSkills, workExperience, parsed.explicitSkillStatements ?? []);

  return { workExperience, education, skills };
}

export async function extractProfileFromText(resumeText: string): Promise<{
  workExperience: WorkExperience[];
  education: EducationRecord[];
  skills: SkillEvidence[];
}> {
  const geminiKey = process.env.GEMINI_API_KEY;
  const anthropicKey = process.env.ANTHROPIC_API_KEY;

  let parsed: RawExtractionResult;

  if (geminiKey) {
  parsed = await extractWithGemini(resumeText, geminiKey);
} else if (anthropicKey) {
  parsed = await extractWithAnthropic(resumeText, anthropicKey);
} else {
    throw new Error(
      "No resume-extraction API key is configured. Set GEMINI_API_KEY (recommended — free tier available) or ANTHROPIC_API_KEY in your deployment environment."
    );
  }

  return postProcessExtraction(parsed);
}
