# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by lib/profileAI.ts to extract structured data from resume text.
# Set ONE of the two below. If GEMINI_API_KEY is set, it's used first; if
# only ANTHROPIC_API_KEY is set, that's used as a fallback.

# Recommended for V0.1 testing — free tier, no billing account required.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override which Gemini model is used (defaults to gemini-2.0-flash
# if left blank). Only needed if Google renames/retires the default model.
GEMINI_MODEL=

# Alternative provider (used only if GEMINI_API_KEY is not set).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if you use scripts/seed-candidate-a.ts (optional, dev/test only).
# Project Settings > API > service_role key. NEVER expose this in the browser
# or commit it — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=
